# Raw downloaded data (large files, redistributable per Toronto Open
# Government License but kept out of the repo to keep it lean — the
# README documents exactly where to download them from)
data/raw/*
!data/raw/.gitkeep

# Generated database and model files (regenerated by running the pipeline)
data/processed/*
!data/processed/.gitkeep

# Power BI CSV exports (regenerated by ttc_pipeline.py --powerbi-export)
dashboard/powerbi_data/*
!dashboard/powerbi_data/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
